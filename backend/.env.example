# LLM API Keys
OPENROUTER_API_KEY=your_openrouter_key
GROQ_API_KEY=your_groq_key

# Retrieval API Keys
TAVILY_API_KEY=your_tavily_key
OPENALEX_API_KEY=your_openalex_key_optional
CORE_API_KEY=your_core_key_optional        # CORE is skipped without a key
CONTACT_EMAIL=you@example.com              # sent to OpenAlex (polite pool)

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_cloud

# Supabase & Persistence
# Use the connection pooler URL when deploying (the direct db.* host is IPv6-only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Per-Agent Model Configuration
# OpenRouter model IDs (e.g. "openai/gpt-5.4-mini") route to OpenRouter.
# Prefix with "groq:" to force Groq (e.g. "groq:openai/gpt-oss-120b").
# Any agent without its own variable falls back to DEFAULT_MODEL.
DEFAULT_MODEL=openai/gpt-5.4-mini
CLARIFICATION_MODEL=anthropic/claude-sonnet-4.5
PLANNING_MODEL=openai/gpt-5.4-mini
RETRIEVAL_MODEL=openai/gpt-5.4-mini
ASSISTANCE_MODEL=openai/gpt-5.4-mini
SYNTHESIS_MODEL=openai/gpt-5.4
WRITING_MODEL=openai/gpt-5.4
CRITIC_MODEL=anthropic/claude-sonnet-4.5
REFINEMENT_MODEL=anthropic/claude-sonnet-4.5
BRAINSTORM_MODEL=deepseek/deepseek-v4-flash
# CHAT_MODEL=openai/gpt-5.4-mini

# Embedding Model (vector size is detected automatically; changing it later
# requires deleting existing Qdrant collections)
EMBEDDING_MODEL=mistralai/mistral-embed-2312
# OPENAI_API_KEY=not_needed_if_using_openrouter_embeddings
